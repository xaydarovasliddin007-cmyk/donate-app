# --- App ---
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_VERSION=v1
CORS_ORIGIN=http://localhost:3000

# --- Database ---
# Local dev DB (see docker-compose.yml at repo root)
DATABASE_URL=postgresql://donate:donate@localhost:5432/donate_app?schema=public

# --- Auth secrets ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-64-byte-random-hex-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-64-byte-random-hex-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Admin auth secrets (must differ from the customer secrets above) ---
ADMIN_JWT_ACCESS_SECRET=replace-with-another-different-64-byte-random-hex-secret
ADMIN_JWT_ACCESS_TTL=15m
ADMIN_JWT_REFRESH_TTL=7d

# --- Google sign-in (optional — see README "Google Sign-In setup") ---
# The OAuth 2.0 Client ID (type "Web application") from Google Cloud Console.
# Without this set, POST /auth/google responds 503 rather than the app
# refusing to boot.
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# --- Rate limiting ---
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# --- Logging ---
LOG_LEVEL=info

# --- Telegram admin notifications (optional) ---
# Create a bot via @BotFather, then message it once from the admin chat/group
# and call https://api.telegram.org/bot<token>/getUpdates to find the chat ID.
# Without these set, notifyAdmins() no-ops silently — never blocks a request.
# TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TELEGRAM_ADMIN_CHAT_ID=-1001234567890
PUBLIC_APP_URL=https://donate-app-5vhs.onrender.com
# TELEGRAM_WEBHOOK_SECRET=generate-a-private-random-32-byte-hex-secret
SUPPORT_TELEGRAM_URL=https://t.me/The_Anonimous_uzb

# --- Payme (optional — see README "Payment gateway setup") ---
# Merchant ID and secret key from https://business.payme.uz. Without these
# set, the PAYME provider never registers itself — DEV_MOCK_PAYMENT keeps
# working for local development.
# PAYME_MERCHANT_ID=xxxxxxxxxxxxxxxxxxxxxxxx
# PAYME_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
PAYME_TEST_MODE=true

# --- Click (optional — see README "Payment gateway setup") ---
# Merchant ID, service ID, and secret key from https://merchant.click.uz.
# Without these set, the CLICK provider never registers itself.
# CLICK_MERCHANT_ID=xxxxxxxxxxxxxxxxxxxxxxxx
# CLICK_SERVICE_ID=xxxxxxxxxxxxxxxxxxxxxxxx
# CLICK_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Digiflazz top-up (optional — see README "Digiflazz top-up setup") ---
# DIGIFLAZZ_USERNAME=xxxxxxxxxx
# DIGIFLAZZ_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Apigames.id top-up, secondary/fallback (optional — see README "Apigames top-up setup") ---
# APIGAMES_USERNAME=xxxxxxxxxx
# APIGAMES_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Humo card-transfer auto top-up (optional — see README "Card-transfer auto top-up setup") ---
# Shared secret the Telegram listener script (scripts/humo-listener.ts) sends
# on every POST to /api/v1/payments/webhooks/humo-transaction. Without this
# set, that endpoint returns 404 and card-transfer top-ups fall back to
# manual admin review in the admin panel.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# HUMO_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# CARD_TRANSACTION_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The four below are read only by scripts/humo-listener.ts (run separately
# via `npm run humo:listener`), not by the backend server itself.
# TELEGRAM_API_ID and TELEGRAM_API_HASH: from https://my.telegram.org →
# "API development tools", logged in as the account registered with
# @HUMOcardbot.
# TELEGRAM_API_ID=xxxxxxx
# TELEGRAM_API_HASH=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Left blank on first run — the script logs in interactively and prints a
# session string; paste it here so later runs don't need to log in again.
# TELEGRAM_SESSION=
# Only needed if the backend isn't at the default http://localhost:4000.
# HUMO_WEBHOOK_URL=http://localhost:4000/api/v1/payments/webhooks/humo-transaction

# --- Email / SMTP (optional — see README "Email setup") ---
# Any standard SMTP account (Gmail app password, SendGrid, Mailgun SMTP,
# your own mail server, ...). Without these set, verification codes are
# logged to the backend console instead of emailed — the flow still works
# end-to-end in dev, just without a real inbox.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-account@gmail.com
# SMTP_PASSWORD=xxxxxxxxxxxxxxxx
SMTP_FROM=UZDONATE <no-reply@uzdonate.dev>
