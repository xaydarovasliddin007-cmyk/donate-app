# --- App ---
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_VERSION=v1
CORS_ORIGIN=http://localhost:3000

# --- Database ---
# Local dev DB (see docker-compose.yml at repo root)
DATABASE_URL=postgresql://donate:donate@localhost:5432/donate_app?schema=public

# --- Auth secrets ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-64-byte-random-hex-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-64-byte-random-hex-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Admin auth secrets (must differ from the customer secrets above) ---
ADMIN_JWT_ACCESS_SECRET=replace-with-another-different-64-byte-random-hex-secret
ADMIN_JWT_ACCESS_TTL=15m
ADMIN_JWT_REFRESH_TTL=7d

# --- Google sign-in (optional — see README "Google Sign-In setup") ---
# The OAuth 2.0 Client ID (type "Web application") from Google Cloud Console.
# Without this set, POST /auth/google responds 503 rather than the app
# refusing to boot.
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# --- Rate limiting ---
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# --- Logging ---
LOG_LEVEL=info

# --- Telegram admin notifications (optional) ---
# Create a bot via @BotFather, then message it once from the admin chat/group
# and call https://api.telegram.org/bot<token>/getUpdates to find the chat ID.
# Without these set, notifyAdmins() no-ops silently — never blocks a request.
# TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TELEGRAM_ADMIN_CHAT_ID=-1001234567890

# --- Payme (optional — see README "Payment gateway setup") ---
# Merchant ID and secret key from https://business.payme.uz. Without these
# set, the PAYME provider never registers itself — DEV_MOCK_PAYMENT keeps
# working for local development.
# PAYME_MERCHANT_ID=xxxxxxxxxxxxxxxxxxxxxxxx
# PAYME_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
PAYME_TEST_MODE=true

# --- Click (optional — see README "Payment gateway setup") ---
# Merchant ID, service ID, and secret key from https://merchant.click.uz.
# Without these set, the CLICK provider never registers itself.
# CLICK_MERCHANT_ID=xxxxxxxxxxxxxxxxxxxxxxxx
# CLICK_SERVICE_ID=xxxxxxxxxxxxxxxxxxxxxxxx
# CLICK_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
