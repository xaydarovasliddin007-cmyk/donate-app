# --- App ---
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_VERSION=v1
CORS_ORIGIN=http://localhost:3000

# --- Database ---
# Local dev DB (see docker-compose.yml at repo root)
DATABASE_URL=postgresql://donate:donate@localhost:5432/donate_app?schema=public

# --- Auth secrets ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-64-byte-random-hex-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-64-byte-random-hex-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Admin auth secrets (must differ from the customer secrets above) ---
ADMIN_JWT_ACCESS_SECRET=replace-with-another-different-64-byte-random-hex-secret
ADMIN_JWT_ACCESS_TTL=15m
ADMIN_JWT_REFRESH_TTL=7d

# --- Rate limiting ---
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# --- Logging ---
LOG_LEVEL=info
