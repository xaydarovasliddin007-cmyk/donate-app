// UZDONATE — database schema
// Money is always integer minor units (e.g. amountMinor=10000, currency="UZS"
// means 100.00 UZS) — never floating point. Every model that stores a price
// carries its own `currency` rather than assuming a global default, so the
// platform can expand beyond UZS later without a schema change.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Customer identity & auth
// ---------------------------------------------------------------------------

enum UserRole {
  CUSTOMER
  ADMIN

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED

  @@map("user_status")
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  // Permanent, human-readable, user-facing identity ("UZD-XXXXXXXX") — never
  // the DB primary key. Generated once at account creation (see
  // lib/public-id.ts) and never changes; safe to show in support/admin
  // search contexts instead of the internal UUID.
  publicId        String     @unique @map("public_id")
  email           String?    @unique
  // Kept for existing accounts/admin lookups, but no longer collected at
  // register/login time — the identifier field is email-only now (see
  // modules/auth). Never populated by new signups.
  phone           String?    @unique
  // Nullable: a Google-only account never sets a password. Every write path
  // that creates a user must set at least one of passwordHash/googleId.
  passwordHash    String?    @map("password_hash")
  googleId        String?    @unique @map("google_id")
  avatarUrl       String?    @map("avatar_url")
  displayName     String?    @map("display_name")
  locale          String     @default("uz")
  role            UserRole   @default(CUSTOMER)
  status          UserStatus @default(ACTIVE)
  // Whole-percent discount (0-100) applied to every order this user places
  // going forward — set by an admin for resellers/partner accounts, not
  // redeemed via a code the way PromoCode is. 0 for everyone else.
  discountPercent Int        @default(0) @map("discount_percent")
  // Set once the user enters a valid code sent to their email
  // (EmailVerificationToken below). Null forever for Google-only accounts'
  // email, since Google already verified it before we ever saw it.
  emailVerifiedAt DateTime?  @map("email_verified_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  refreshTokens           RefreshToken[]
  orders                  Order[]
  savedPlayerProfiles     SavedPlayerProfile[]
  wallet                  Wallet?
  topUpRequests           TopUpRequest[]
  notifications           Notification[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  promoCodeRedemptions    PromoCodeRedemption[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Email verification — a short numeric code (not a link) so there's no
// mobile deep-linking to wire up: the user just types the 6 digits from
// their inbox into the app. Only the hash is stored, same reasoning as
// RefreshToken. Never blocks login/registration — see auth.service.ts.
// ---------------------------------------------------------------------------

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("email_verification_tokens")
}

// A short numeric code (same shape/reasoning as EmailVerificationToken)
// emailed to prove control of the account's inbox before letting a
// forgotten password be replaced. Never blocks anything else — an account
// with no pending reset just has no rows here.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @map("code_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

// A registration that hasn't been completed yet: email verified-code sent,
// but no password set and no User row created. Lets the signup flow ask for
// the password only after the code is confirmed, instead of creating an
// account up front. Completing it (see auth.service.ts) creates the real
// User (already email-verified) and deletes this row; a fresh signup
// attempt for the same email just overwrites it.
model PendingRegistration {
  id          String   @id @default(uuid()) @db.Uuid
  email       String   @unique
  codeHash    String   @map("code_hash")
  displayName String?  @map("display_name")
  locale      String   @default("uz")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("pending_registrations")
}

// One saved player identity per (user, game) — "My Games" on the home
// screen. Upserted automatically whenever an order is created for that
// game (see orders.service.ts), so returning users never have to retype
// their Player ID/Server ID; also editable directly via the saved-games API.
model SavedPlayerProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId    String   @map("game_id") @db.Uuid
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  playerId  String   @map("player_id")
  serverId  String?  @map("server_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, gameId])
  @@map("saved_player_profiles")
}

model RefreshToken {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash           String    @unique @map("token_hash")
  expiresAt           DateTime  @map("expires_at")
  revokedAt           DateTime? @map("revoked_at")
  replacedByTokenHash String?   @map("replaced_by_token_hash")
  userAgent           String?   @map("user_agent")
  ipAddress           String?   @map("ip_address")
  createdAt           DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Admin identity & auth — deliberately separate from User/RefreshToken:
// different login surface, different RBAC, must never be reachable through
// the customer-facing auth endpoints.
// ---------------------------------------------------------------------------

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  OPERATIONS
  SUPPORT
  FINANCE
  CONTENT_MANAGER

  @@map("admin_role")
}

model AdminUser {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  role         AdminRole @default(SUPPORT)
  isActive     Boolean   @default(true) @map("is_active")
  // Brute-force lockout: counts consecutive bad-password attempts since the
  // last success, reset to 0 on any successful login. lockedUntil is set
  // once the count hits the threshold and blocks login until it passes,
  // regardless of correct password.
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  refreshTokens      AdminRefreshToken[]
  auditLogs          AuditLog[]
  walletTransactions WalletTransaction[]
  reviewedTopUps     TopUpRequest[]
  createdPromoCodes  PromoCode[]

  @@map("admin_users")
}

// ---------------------------------------------------------------------------
// Promo codes — a fixed-bonus code a customer redeems once for a wallet
// credit. Deliberately simple (flat bonus, not percentage-off-purchase):
// this is a marketing/growth lever, not a discount-at-checkout system, so it
// reuses the exact same ledger path (wallet.service.ts's creditWallet) as
// every other balance change — no parallel "promo balance" to reconcile.
// ---------------------------------------------------------------------------

model PromoCode {
  id               String     @id @default(uuid()) @db.Uuid
  // Stored uppercase; redemption lookups normalize the input the same way.
  code             String     @unique
  bonusAmountMinor Int        @map("bonus_amount_minor")
  currency         String     @default("UZS")
  // Null = unlimited redemptions (until expiresAt/isActive says otherwise).
  maxRedemptions   Int?       @map("max_redemptions")
  redemptionCount  Int        @default(0) @map("redemption_count")
  expiresAt        DateTime?  @map("expires_at")
  isActive         Boolean    @default(true) @map("is_active")
  createdAt        DateTime   @default(now()) @map("created_at")
  createdByAdminId String?    @map("created_by_admin_id") @db.Uuid
  createdByAdmin   AdminUser? @relation(fields: [createdByAdminId], references: [id])

  redemptions PromoCodeRedemption[]

  @@map("promo_codes")
}

model PromoCodeRedemption {
  id          String    @id @default(uuid()) @db.Uuid
  promoCodeId String    @map("promo_code_id") @db.Uuid
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  userId      String    @map("user_id") @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  redeemedAt  DateTime  @default(now()) @map("redeemed_at")

  // The actual one-redemption-per-user-per-code guard — DB-enforced, not
  // just checked-then-written in application code.
  @@unique([promoCodeId, userId])
  @@map("promo_code_redemptions")
}

model AdminRefreshToken {
  id          String    @id @default(uuid()) @db.Uuid
  adminUserId String    @map("admin_user_id") @db.Uuid
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([adminUserId])
  @@map("admin_refresh_tokens")
}

// ---------------------------------------------------------------------------
// Catalog: games & products
// ---------------------------------------------------------------------------

enum GameAvailability {
  ACTIVE // has at least one provider-backed product and can be purchased
  COMING_SOON // visible in the catalog but not yet purchasable
  DISABLED // hidden from the catalog entirely

  @@map("game_availability")
}

model Game {
  id           String           @id @default(uuid()) @db.Uuid
  slug         String           @unique
  name         String
  // Free-text category label (e.g. "MOBA", "Battle Royale"). A dedicated
  // Category table would be premature at this catalog size — this is enough
  // for the home screen's category filter.
  category     String?
  logoEmoji    String?          @map("logo_emoji")
  // Remote icon URL (e.g. the game's official Play Store listing icon).
  // Nullable — the mobile app falls back to logoEmoji/a colored initial
  // avatar when this isn't set.
  logoUrl      String?          @map("logo_url")
  availability GameAvailability @default(COMING_SOON)
  sortOrder    Int              @default(0) @map("sort_order")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  products            Product[]
  servers             GameServer[]
  orders              Order[]
  savedPlayerProfiles SavedPlayerProfile[]

  @@map("games")
}

// A game's regional/version servers (e.g. Mobile Legends' many regional
// servers), each optionally priced differently via Product.serverId. Games
// with no rows here behave exactly as before this model existed — the
// mobile app's server field stays free-text and Product.serverId stays null.
model GameServer {
  id        String   @id @default(uuid()) @db.Uuid
  gameId    String   @map("game_id") @db.Uuid
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  name      String
  code      String
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@unique([gameId, code])
  @@index([gameId])
  @@map("game_servers")
}

model Product {
  id          String      @id @default(uuid()) @db.Uuid
  gameId      String      @map("game_id") @db.Uuid
  game        Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  // Nullable: only set for games whose products are priced per-server
  // (see GameServer). Games without a server catalog leave this null.
  serverId    String?     @map("server_id") @db.Uuid
  server      GameServer? @relation(fields: [serverId], references: [id], onDelete: Cascade)
  name        String
  description String?
  amountMinor Int         @map("amount_minor")
  // What this actually costs (the supplier/provider price), separate from
  // amountMinor (what the customer pays) — the input the profit stats on
  // the admin dashboard are built from. Null means "not entered yet," not
  // "free": every profit calculation explicitly excludes such products
  // rather than treating the gap as pure margin. Snapshotted onto
  // OrderItem.costMinorSnapshot at purchase time so a later cost change
  // never rewrites a past order's already-reported profit.
  costMinor   Int?        @map("cost_minor")
  currency    String      @default("UZS")
  isActive    Boolean     @default(true) @map("is_active")
  // Marks development/seed catalog data so it's never confused with a real,
  // provider-verified product once real catalogs are connected.
  isTest      Boolean     @default(true) @map("is_test")
  sortOrder   Int         @default(0) @map("sort_order")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  providerProducts ProviderProduct[]
  orderItems       OrderItem[]

  @@index([gameId, serverId])
  @@map("products")
}

// ---------------------------------------------------------------------------
// Providers — both payment providers (Payme/Click/...) and top-up/fulfillment
// providers (the game-credit suppliers) live in the same table distinguished
// by `type`, since they share identical operational concerns: health,
// credentials-on-backend-only, and per-product mapping.
// ---------------------------------------------------------------------------

enum ProviderType {
  PAYMENT
  TOPUP

  @@map("provider_type")
}

enum ProviderHealthStatus {
  UNKNOWN
  HEALTHY
  DEGRADED
  DOWN

  @@map("provider_health_status")
}

model Provider {
  id            String               @id @default(uuid()) @db.Uuid
  code          String               @unique
  name          String
  type          ProviderType
  isActive      Boolean              @default(true) @map("is_active")
  healthStatus  ProviderHealthStatus @default(UNKNOWN) @map("health_status")
  lastCheckedAt DateTime?            @map("last_checked_at")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  providerProducts ProviderProduct[]
  providerAttempts ProviderAttempt[]
  payments         Payment[]

  @@map("providers")
}

model ProviderProduct {
  id                  String   @id @default(uuid()) @db.Uuid
  providerId          String   @map("provider_id") @db.Uuid
  provider            Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  productId           String   @map("product_id") @db.Uuid
  product             Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  providerProductCode String   @map("provider_product_code")
  // Lower priority is tried first — enables automatic fallback to another
  // provider for the same product when the primary one is unhealthy.
  priority            Int      @default(0)
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")

  @@unique([providerId, productId])
  @@index([productId])
  @@map("provider_products")
}

// ---------------------------------------------------------------------------
// Orders — explicit state machine enforced in application code
// (see backend/src/modules/orders/order-state-machine.ts), never a bare
// `UPDATE orders SET status = ...`.
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED

  @@map("order_status")
}

model Order {
  id             String      @id @default(uuid()) @db.Uuid
  orderNumber    String      @unique @map("order_number")
  userId         String      @map("user_id") @db.Uuid
  user           User        @relation(fields: [userId], references: [id])
  gameId         String      @map("game_id") @db.Uuid
  game           Game        @relation(fields: [gameId], references: [id])
  playerId       String      @map("player_id")
  // The pricing region (see GameServer) — which Product row/price applies.
  // Distinct from zoneId below: a game can have both, one, or neither.
  serverId       String?     @map("server_id")
  // The player's real in-game server/zone (e.g. Mobile Legends' numeric
  // Zone ID) — sent to the fulfillment provider to identify the account.
  // Unrelated to serverId/GameServer, which is about pricing, not identity.
  zoneId         String?     @map("zone_id")
  // The actual charged total, after any per-user discount — see User.discountPercent.
  amountMinor    Int         @map("amount_minor")
  currency       String      @default("UZS")
  // Snapshot of the discount actually applied, in case the user's own
  // discountPercent changes later — an old order must keep showing what it
  // was charged at, not silently recompute against a different rate.
  discountPercent Int        @default(0) @map("discount_percent")
  status         OrderStatus @default(PENDING)
  // Client-supplied key (e.g. a UUID generated once per checkout attempt) so
  // a retried "Buy now" tap can never create two orders.
  idempotencyKey String      @unique @map("idempotency_key")
  failureReason  String?     @map("failure_reason")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  paidAt         DateTime?   @map("paid_at")
  completedAt    DateTime?   @map("completed_at")

  items              OrderItem[]
  statusHistory      OrderStatusHistory[]
  payments           Payment[]
  providerAttempts   ProviderAttempt[]
  walletTransactions WalletTransaction[]

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id               String   @id @default(uuid()) @db.Uuid
  orderId          String   @map("order_id") @db.Uuid
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String   @map("product_id") @db.Uuid
  product          Product  @relation(fields: [productId], references: [id])
  // Snapshots at purchase time so a later price/name change never rewrites
  // history on past orders.
  productName      String   @map("product_name")
  quantity         Int      @default(1)
  unitAmountMinor  Int      @map("unit_amount_minor")
  totalAmountMinor Int      @map("total_amount_minor")
  // Snapshot of Product.costMinor at the moment this order was placed — per
  // unit, same as unitAmountMinor. Null whenever the product's cost hadn't
  // been entered yet at purchase time (including every order placed before
  // this column existed); the profit stats treat that as "unknown," not
  // "zero cost," and exclude the item rather than overstate margin.
  costMinorSnapshot Int?    @map("cost_minor_snapshot")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id         String       @id @default(uuid()) @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  reason     String?
  createdAt  DateTime     @default(now()) @map("created_at")

  @@index([orderId])
  @@map("order_status_history")
}

// ---------------------------------------------------------------------------
// Payments — payment *intent/status* is intentionally separate from order
// status: a payment can succeed while fulfillment (ProviderAttempt) is still
// pending or fails, and an order can be refunded well after payment settled.
// ---------------------------------------------------------------------------

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED

  @@map("payment_status")
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  orderId        String        @map("order_id") @db.Uuid
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  providerId     String?       @map("provider_id") @db.Uuid
  provider       Provider?     @relation(fields: [providerId], references: [id])
  amountMinor    Int           @map("amount_minor")
  currency       String        @default("UZS")
  status         PaymentStatus @default(PENDING)
  idempotencyKey String        @unique @map("idempotency_key")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  attempts PaymentAttempt[]

  @@index([orderId])
  @@map("payments")
}

enum PaymentAttemptStatus {
  INITIATED
  SUCCEEDED
  FAILED

  @@map("payment_attempt_status")
}

model PaymentAttempt {
  id          String               @id @default(uuid()) @db.Uuid
  paymentId   String               @map("payment_id") @db.Uuid
  payment     Payment              @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  providerRef String?              @map("provider_ref")
  status      PaymentAttemptStatus @default(INITIATED)
  rawResponse Json?                @map("raw_response")
  createdAt   DateTime             @default(now()) @map("created_at")

  @@index([paymentId])
  @@map("payment_attempts")
}

// ---------------------------------------------------------------------------
// Fulfillment — one row per attempt to actually deliver the top-up through a
// TOPUP provider. Kept separate from Payment: money can be captured
// successfully while fulfillment retries independently.
// ---------------------------------------------------------------------------

enum ProviderAttemptStatus {
  PENDING
  SUCCESS
  FAILED

  @@map("provider_attempt_status")
}

model ProviderAttempt {
  id                    String                @id @default(uuid()) @db.Uuid
  orderId               String                @map("order_id") @db.Uuid
  order                 Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  providerId            String                @map("provider_id") @db.Uuid
  provider              Provider              @relation(fields: [providerId], references: [id])
  providerProductCode   String                @map("provider_product_code")
  attemptNumber         Int                   @default(1) @map("attempt_number")
  status                ProviderAttemptStatus @default(PENDING)
  providerTransactionId String?               @map("provider_transaction_id")
  requestPayload        Json?                 @map("request_payload")
  responsePayload       Json?                 @map("response_payload")
  createdAt             DateTime              @default(now()) @map("created_at")
  completedAt           DateTime?             @map("completed_at")

  @@index([orderId])
  @@map("provider_attempts")
}

// ---------------------------------------------------------------------------
// Webhooks — processing must be idempotent: the unique constraint on
// (provider, providerEventId) is the actual guarantee, application code must
// not rely on "we probably won't get it twice".
// ---------------------------------------------------------------------------

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED

  @@map("webhook_status")
}

model WebhookEvent {
  id              String        @id @default(uuid()) @db.Uuid
  provider        String
  providerEventId String        @map("provider_event_id")
  eventType       String        @map("event_type")
  receivedAt      DateTime      @default(now()) @map("received_at")
  processedAt     DateTime?     @map("processed_at")
  status          WebhookStatus @default(RECEIVED)
  payload         Json

  @@unique([provider, providerEventId])
  @@map("webhook_events")
}

// ---------------------------------------------------------------------------
// Promotions & audit
// ---------------------------------------------------------------------------

model Promotion {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @unique
  title       String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  startsAt    DateTime? @map("starts_at")
  endsAt      DateTime? @map("ends_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("promotions")
}

enum AuditActorType {
  ADMIN
  SYSTEM

  @@map("audit_actor_type")
}

model AuditLog {
  id         String         @id @default(uuid()) @db.Uuid
  actorType  AuditActorType @map("actor_type")
  actorId    String?        @map("actor_id") @db.Uuid
  actor      AdminUser?     @relation(fields: [actorId], references: [id])
  action     String
  entityType String         @map("entity_type")
  entityId   String?        @map("entity_id")
  metadata   Json?
  createdAt  DateTime       @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Wallet — a CLOSED internal balance for UZDONATE purchases only. No P2P
// transfers, no withdrawal to cards, no cash-out — enforced entirely in
// application code (wallet.service.ts never exposes an operation that moves
// money to anything but an order/refund/admin-adjustment/top-up).
//
// The balance on `Wallet.balanceMinor` is a cache, not the source of truth:
// every mutation happens inside walletService.applyLedgerEntry(), which
// writes the WalletTransaction row and updates balanceMinor in the SAME
// database transaction, and every entry carries an idempotencyKey with a
// unique constraint — that's what actually prevents double-crediting a
// webhook retry or a concurrent admin double-click, not just "careful code".
// ---------------------------------------------------------------------------

enum WalletTransactionType {
  TOPUP
  PURCHASE
  REFUND
  ADJUSTMENT
  BONUS

  @@map("wallet_transaction_type")
}

enum WalletTransactionDirection {
  CREDIT
  DEBIT

  @@map("wallet_transaction_direction")
}

model Wallet {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balanceMinor Int      @default(0) @map("balance_minor")
  currency     String   @default("UZS")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id                String                     @id @default(uuid()) @db.Uuid
  walletId          String                     @map("wallet_id") @db.Uuid
  wallet            Wallet                     @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type              WalletTransactionType
  direction         WalletTransactionDirection
  // Always positive — `direction` says which way it moved.
  amountMinor       Int                        @map("amount_minor")
  currency          String                     @default("UZS")
  // Immutable snapshot of the balance immediately after this entry, so the
  // running balance can be verified/reconstructed without re-summing the
  // whole table.
  balanceAfterMinor Int                        @map("balance_after_minor")
  // The actual double-application guard for this specific ledger entry
  // (e.g. "topup:<topUpRequestId>", "order-refund:<orderId>",
  // "order-purchase:<orderId>") — not best-effort, DB-enforced.
  idempotencyKey    String                     @unique @map("idempotency_key")
  reference         String?
  // Required (enforced in service code) for ADJUSTMENT entries — why an
  // admin moved money without a top-up/order behind it.
  reason            String?
  orderId           String?                    @map("order_id") @db.Uuid
  order             Order?                     @relation(fields: [orderId], references: [id])
  topUpRequestId    String?                    @map("top_up_request_id") @db.Uuid
  topUpRequest      TopUpRequest?              @relation(fields: [topUpRequestId], references: [id])
  createdByAdminId  String?                    @map("created_by_admin_id") @db.Uuid
  createdByAdmin    AdminUser?                 @relation(fields: [createdByAdminId], references: [id])
  metadata          Json?
  createdAt         DateTime                   @default(now()) @map("created_at")

  @@index([walletId])
  @@index([orderId])
  @@index([topUpRequestId])
  @@map("wallet_transactions")
}

// ---------------------------------------------------------------------------
// UZDONATE card-transfer top-up — a manual method: admin configures which
// cards receive transfers, the user submits a request after transferring,
// and balance is credited ONLY once an admin (or a future automated bank
// integration) verifies it actually arrived. A user claiming "I paid" is
// never sufficient by itself — see saved-games.service-style honesty
// comments throughout this codebase re: never faking success.
// ---------------------------------------------------------------------------

enum ReceivingMethodType {
  CARD_TRANSFER
  QR_CODE
  PAYNET_TERMINAL

  @@map("receiving_method_type")
}

model ReceivingMethod {
  id   String              @id @default(uuid()) @db.Uuid
  type ReceivingMethodType @default(CARD_TRANSFER)
  // The FULL card number (e.g. "8600 1234 5678 8882") — not a real PAN
  // security concern the way a debit/credit card's CVV+expiry would be
  // (a receive-only card-transfer target being known lets someone send it
  // money, not take money out), and the customer needs the complete
  // number displayed to actually key it into their own banking app.
  // Only set for CARD_TRANSFER.
  cardNumber String? @map("card_number")
  // For CARD_TRANSFER this is the cardholder's name; for QR_CODE /
  // PAYNET_TERMINAL it's just the label shown to the user (e.g. "Paynet
  // QR", "Paynet terminal") — every type needs a display name, so the one
  // field covers both rather than adding a separate "label" column.
  cardHolderName String  @map("card_holder_name")
  bankName       String? @map("bank_name")
  // The raw Paynet (or other provider) QR payload/link — rendered as an
  // actual QR image client-side. Only set for QR_CODE / PAYNET_TERMINAL.
  qrPayload String? @map("qr_payload")
  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  topUpRequests TopUpRequest[]

  @@map("receiving_methods")
}

enum TopUpRequestStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED

  @@map("top_up_request_status")
}

model TopUpRequest {
  id                String             @id @default(uuid()) @db.Uuid
  userId            String             @map("user_id") @db.Uuid
  user              User               @relation(fields: [userId], references: [id])
  // Null until a matching bank transaction actually lands (or, for the
  // manual admin-verify path, until an admin identifies which card it
  // arrived on) — the reservation flow shows the user every active card
  // and lets them transfer to whichever one they like, disambiguated by
  // amountMinor being unique among concurrently pending requests, not by
  // being tied to one exclusive card up front.
  receivingMethodId String?            @map("receiving_method_id") @db.Uuid
  receivingMethod   ReceivingMethod?   @relation(fields: [receivingMethodId], references: [id])
  // What the user actually asked to pay with. Card-shaped options
  // (CARD_TRANSFER, and PAYNET_TERMINAL — cash deposited at a Paynet kiosk
  // still lands on the same card via NBU's interbank rails) all hand back
  // the same `receivingMethods` card list, so this is the only reliable
  // signal for which UI the client should render (card tiles + reference
  // field vs a QR image) — `receivingMethods.first.type` can't be trusted
  // for that once PAYNET_TERMINAL started reusing CARD_TRANSFER rows.
  // Nullable because rows created before this column existed have none.
  type              ReceivingMethodType? @map("type")
  amountMinor       Int                @map("amount_minor")
  currency          String             @default("UZS")
  status            TopUpRequestStatus @default(PENDING)
  // What the user tells us (their card's last digits, transfer time, etc.)
  // to help an admin match it against a real bank statement — a hint, not
  // proof; only `reviewedByAdminId`+`status=VERIFIED` actually credits the
  // wallet.
  userReference     String?            @map("user_reference")
  // Set when the customer taps "I've paid" (CARD_TRANSFER/QR_CODE — the
  // types with no automated proof-of-payment feed). A claim, not proof:
  // credits nothing by itself, just tells the admin queue this one is
  // worth checking now rather than a still-unpaid reservation sitting out
  // its countdown.
  userConfirmedPaidAt DateTime?        @map("user_confirmed_paid_at")
  // Set only by reserveTopUpRequest() (the "assign me one free card"
  // flow) — null for the older free-pick flow. A PENDING request past this
  // time no longer blocks its amount from being reserved by someone else,
  // even before a sweep flips its status to EXPIRED.
  expiresAt         DateTime?          @map("expires_at")
  // True when a Telegram bank-notification match (see modules/topup/humo-webhook.ts)
  // verified this automatically, rather than an admin — reviewedByAdminId
  // stays null in that case.
  autoVerified      Boolean            @default(false) @map("auto_verified")
  reviewedByAdminId String?            @map("reviewed_by_admin_id") @db.Uuid
  reviewedByAdmin   AdminUser?         @relation(fields: [reviewedByAdminId], references: [id])
  reviewedAt        DateTime?          @map("reviewed_at")
  rejectionReason   String?            @map("rejection_reason")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  walletTransactions WalletTransaction[]

  @@index([userId])
  @@index([status])
  @@map("top_up_requests")
}

// ---------------------------------------------------------------------------
// In-app notifications — real, DB-backed, listed via GET /notifications.
// Actual push delivery (Firebase Cloud Messaging) is not wired: that needs
// a Firebase project's credentials, which this environment doesn't have.
// Rows are still created for every event listed below, so the in-app
// notification center is fully real even before FCM exists.
// ---------------------------------------------------------------------------

enum NotificationType {
  ORDER_SUCCESS
  ORDER_FAILED
  PAYMENT_SUCCESS
  TOPUP_SUCCESS
  REFUND
  SECURITY
  PROMOTION

  @@map("notification_type")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  // Deep-link target the Flutter app navigates to on tap, e.g. "/orders/<id>".
  deepLink  String?          @map("deep_link")
  readAt    DateTime?        @map("read_at")
  metadata  Json?
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([userId])
  @@index([userId, readAt])
  @@map("notifications")
}
